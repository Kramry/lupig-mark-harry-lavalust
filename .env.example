# Copy this file to .env and update the values below
# cp .env.example .env
# php lava key:generate

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
# Local Laragon/XAMPP: host=localhost, port=3306, username=root
# Aiven: use the host/port/user from the service Overview page (not localhost / 3306)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=mydb
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Aiven TLS: download the CA certificate and set the path, e.g. C:\laragon\www\LavaLust-dev-v4\certs\ca.pem
# Leave empty for local MySQL.
DB_SSL_CA=
